<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- UI 設計 2章の色(採用案 A+B)。View は直接の色を書かず、ここを参照する -->
    <SolidColorBrush x:Key="Background" Color="#F7F7F5" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Border" Color="#E2E2DE" />
    <SolidColorBrush x:Key="BorderStrong" Color="#C9C9C4" />
    <SolidColorBrush x:Key="Text" Color="#1B1B1F" />
    <SolidColorBrush x:Key="TextSub" Color="#55575E" />
    <SolidColorBrush x:Key="Accent" Color="#2F5BD3" />
    <SolidColorBrush x:Key="AccentDark" Color="#1F3F9E" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E8EEFB" />
    <SolidColorBrush x:Key="Mistake" Color="#B54708" />
    <SolidColorBrush x:Key="MistakeText" Color="#8A3505" />
    <SolidColorBrush x:Key="MistakeSoft" Color="#FDE3CF" />
    <SolidColorBrush x:Key="MistakeSofter" Color="#FDF0E6" />
    <SolidColorBrush x:Key="Danger" Color="#B42318" />
    <SolidColorBrush x:Key="DangerText" Color="#8F1B12" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FEECEB" />
    <SolidColorBrush x:Key="Saved" Color="#3B5E3F" />
    <SolidColorBrush x:Key="DisabledBackground" Color="#EDEDEA" />
    <SolidColorBrush x:Key="DisabledText" Color="#5F6166" />

    <!-- UI 設計 3章の文字。英単語は等幅(無ければ Consolas) -->
    <FontFamily x:Key="UiFont">Yu Gothic UI, Segoe UI</FontFamily>
    <FontFamily x:Key="WordFont">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="BodySize">15</sys:Double>
    <sys:Double x:Key="SubSize">13</sys:Double>
    <sys:Double x:Key="HeadingSize">26</sys:Double>
    <sys:Double x:Key="PromptSize">34</sys:Double>
    <sys:Double x:Key="AnswerSize">34</sys:Double>
</ResourceDictionary>
