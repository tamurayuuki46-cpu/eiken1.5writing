<UserControl x:Class="EikenSpelling.Wpf.Views.BothCorruptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="600" Margin="24,64,24,24" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Heading}" FontSize="24" Text="学習記録を読み込めませんでした" HorizontalAlignment="Center" Margin="0,0,0,16" />
            <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource TextSub}" TextAlignment="Center" LineHeight="26" Margin="0,0,0,24"
                       Text="学習記録とバックアップの両方が壊れています。&#x0a;壊れたファイルは消さずに残してあります。" />
            <Border Style="{StaticResource WarnBand}" Margin="0,0,0,16" Visibility="{Binding Message, Converter={StaticResource NotNullToVisible}}">
                <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource DangerText}" Text="{Binding Message, StringFormat=⚠ {0}}" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource DangerButton}" Content="新しい記録で始める" Margin="0,0,12,0" Command="{Binding StartFreshCommand}" />
                <Button x:Name="ExitButton" Style="{StaticResource SecondaryButton}" Content="終了" Command="{Binding ExitCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
