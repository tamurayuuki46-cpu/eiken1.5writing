<UserControl x:Class="EikenSpelling.Wpf.Views.VocabularySetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
    </UserControl.InputBindings>
    <DockPanel>
        <!-- 下: 操作(開始が主、戻るは固定)。開始条件は一覧のスクロールの中(200% でも一覧が潰れないように) -->
        <StackPanel DockPanel.Dock="Bottom" Margin="24,8,24,20" MaxWidth="760">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" MinWidth="260" MinHeight="52" FontSize="18" Margin="0,0,12,0"
                        Content="このセットで始める" Command="{Binding StartCommand}"
                        AutomationProperties.HelpText="選んでいるセットの語だけで練習を始めます。出せる問題が足りないときは確認が出ます" />
                <Button x:Name="BackButton" Style="{StaticResource SecondaryButton}" MinWidth="160" MinHeight="52" FontSize="18"
                        Content="ホームへ戻る" Command="{Binding BackCommand}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,6,0,0" Text="Esc でホームへ戻る" />
        </StackPanel>

        <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel MaxWidth="760" Margin="24,20,24,8">
                <TextBlock Style="{StaticResource Heading}" Text="語彙セット" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Body}" Text="{Binding PageText}" Margin="0,0,0,10"
                           AutomationProperties.LiveSetting="Polite" />

                <!-- 開始条件(今回だけ。基本設定は変わらない) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Sub}" FontWeight="Bold" Text="このセットで始める条件(今回だけ・基本設定は変わりません)" Margin="0,0,0,8" />
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                <Label Target="{Binding ElementName=CountBox}" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource TextSub}" Content="問題数(_N)" />
                                <ComboBox x:Name="CountBox" MinWidth="96" ItemsSource="{Binding QuestionCountOptions}" SelectedItem="{Binding SelectedQuestionCount}"
                                          AutomationProperties.Name="問題数" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                <Label Target="{Binding ElementName=ModeBox}" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource TextSub}" Content="出題(_M)" />
                                <ComboBox x:Name="ModeBox" MinWidth="240" ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}"
                                          DisplayMemberPath="Label" AutomationProperties.Name="出題方法" />
                            </StackPanel>
                            <CheckBox Content="苦手のみ(_W)" IsChecked="{Binding WeakOnly}" Margin="0,0,0,4" VerticalAlignment="Center" Foreground="{StaticResource TextSub}" />
                        </WrapPanel>
                        <Border Style="{StaticResource InfoBand}" Margin="0,6,0,0"
                                Visibility="{Binding SelectedModeUnavailableNote, Converter={StaticResource NotNullToVisible}}">
                            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding SelectedModeUnavailableNote}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 表示単位と前後移動(閲覧だけ。何も書かない) -->
                <WrapPanel Margin="0,0,0,12">
                    <Button x:Name="Unit50Button" Style="{StaticResource SecondaryButton}" Content="{Binding Unit50Label}" Command="{Binding Unit50Command}" Margin="0,0,8,0" />
                    <Button x:Name="Unit100Button" Style="{StaticResource SecondaryButton}" Content="{Binding Unit100Label}" Command="{Binding Unit100Command}" Margin="0,0,24,0" />
                    <Button x:Name="PreviousButton" Style="{StaticResource SecondaryButton}" Content="前のセット" Command="{Binding PreviousCommand}" Margin="0,0,8,0" />
                    <Button x:Name="NextButton" Style="{StaticResource SecondaryButton}" Content="次のセット" Command="{Binding NextCommand}" />
                </WrapPanel>

                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,4" Padding="14,6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" VerticalAlignment="Center" MinWidth="72" TextAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Sub}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWeak}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource MistakeText}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontFamily="{StaticResource WordFont}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text}"
                                               Text="{Binding Word}" VerticalAlignment="Center" Width="190" Margin="0,0,12,0" />
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding Japanese}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
