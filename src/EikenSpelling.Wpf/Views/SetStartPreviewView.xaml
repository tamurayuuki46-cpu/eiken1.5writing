<UserControl x:Class="EikenSpelling.Wpf.Views.SetStartPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="560" Margin="24,48,24,24" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Center" Text="{Binding SetText}" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource Heading}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding Headline}" Margin="0,0,0,20"
                       AutomationProperties.LiveSetting="Polite" />

            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" Padding="24,14" Margin="0,0,0,20">
                <TextBlock Style="{StaticResource Body}">
                    <Run Text="希望 " Foreground="{StaticResource TextSub}" /><Run Text="{Binding Desired, Mode=OneWay}" FontWeight="Bold" /><Run Text=" 問" />
                    <Run Text="    出題可能 " Foreground="{StaticResource TextSub}" /><Run Text="{Binding Available, Mode=OneWay}" FontWeight="Bold" /><Run Text=" 問" />
                </TextBlock>
            </Border>

            <Border Style="{StaticResource InfoBand}" Margin="0,0,0,12" Visibility="{Binding StaleNotice, Converter={StaticResource NotNullToVisible}}">
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding StaleNotice}" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <Border Style="{StaticResource InfoBand}" Margin="0,0,0,12" Visibility="{Binding ReasonText, Converter={StaticResource NotNullToVisible}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding ReasonText}" />
                    <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Hint}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource WarnBand}" Margin="0,0,0,12" Visibility="{Binding SaveFailure, Converter={StaticResource NotNullToVisible}}">
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Foreground="{StaticResource DangerText}" Text="{Binding SaveFailure, StringFormat=⚠ {0}}"
                           AutomationProperties.LiveSetting="Assertive" />
            </Border>

            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Width="340" MinHeight="60" FontSize="20" Margin="0,0,0,12"
                    Content="{Binding StartLabel}" Command="{Binding ConfirmCommand}"
                    Visibility="{Binding CanStart, Converter={StaticResource BoolToVisible}}"
                    AutomationProperties.HelpText="いま確認した問題だけで始めます" />
            <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Width="340" MinHeight="52"
                    Content="条件に戻る" Command="{Binding CancelCommand}" />
            <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,10,0,0" Text="Esc で条件に戻ります。戻るまで何も記録されません" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
