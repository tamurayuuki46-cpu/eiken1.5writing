<UserControl x:Class="EikenSpelling.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 設定(UI v0.3 S-07、UX 設計: 先頭の項目にフォーカス、Enter = 保存、Esc = 閉じる) -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="580" Margin="24,32,24,24">
            <TextBlock Style="{StaticResource Heading}" Text="設定" Margin="0,0,0,16" />

            <Border Style="{StaticResource InfoBand}" Margin="0,0,0,12" Visibility="{Binding CannotSaveReason, Converter={StaticResource NotNullToVisible}}">
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding CannotSaveReason}" />
            </Border>
            <Border Style="{StaticResource InfoBand}" Margin="0,0,0,12" Visibility="{Binding Note, Converter={StaticResource NotNullToVisible}}">
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding Note}" />
            </Border>
            <Border Style="{StaticResource WarnBand}" Margin="0,0,0,12" Visibility="{Binding Message, Converter={StaticResource NotNullToVisible}}">
                <StackPanel>
                    <TextBlock x:Name="MessageText" Style="{StaticResource Body}" TextWrapping="Wrap" Foreground="{StaticResource DangerText}" Text="{Binding Message, StringFormat=⚠ {0}}"
                               AutomationProperties.LiveSetting="Assertive" />
                    <ItemsControl ItemsSource="{Binding Issues}" Focusable="False" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Foreground="{StaticResource DangerText}" Text="{Binding StringFormat=・{0}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Sub}" FontWeight="Bold" Text="1日の目標" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Label Target="{Binding ElementName=GoalBox}" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource TextSub}" Content="採点する問題数(_G)" />
                        <ComboBox x:Name="GoalBox" MinWidth="96" ItemsSource="{Binding DailyGoalOptions}" SelectedItem="{Binding SelectedDailyGoal}"
                                  ItemStringFormat="{}{0}問" AutomationProperties.Name="1日の目標の問題数" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="通常問題・後回しで答えた問題・答えを見た問題を1問と数えます(再練習は数えません)。1回の練習の問題数とは別です。目標を変えても、今日までの実績は変わりません。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Sub}" FontWeight="Bold" Text="練習の基本設定(おすすめ学習・自由選択の初期値)" Margin="0,0,0,12" />
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                            <Label Target="{Binding ElementName=CountBox}" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource TextSub}" Content="1回の問題数(_N)" />
                            <ComboBox x:Name="CountBox" MinWidth="96" ItemsSource="{Binding QuestionCountOptions}" SelectedItem="{Binding SelectedQuestionCount}"
                                      AutomationProperties.Name="1回の問題数" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                            <Label Target="{Binding ElementName=ModeBox}" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource TextSub}" Content="出題(_M)" />
                            <ComboBox x:Name="ModeBox" MinWidth="240" ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}"
                                      DisplayMemberPath="Label" AutomationProperties.Name="出題方法" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                            <Label Target="{Binding ElementName=FlashBox}" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource TextSub}" Content="フラッシュ表示(_F)" />
                            <ComboBox x:Name="FlashBox" MinWidth="96" ItemsSource="{Binding FlashSecondsOptions}" SelectedItem="{Binding SelectedFlashSeconds}"
                                      ItemStringFormat="{}{0}秒" AutomationProperties.Name="フラッシュの表示秒数" />
                        </StackPanel>
                        <CheckBox Content="苦手のみ(_W)" IsChecked="{Binding WeakOnly}" Margin="0,0,0,10" VerticalAlignment="Center" Foreground="{StaticResource TextSub}" />
                    </WrapPanel>
                    <Border Style="{StaticResource InfoBand}" Margin="0,0,0,4"
                            Visibility="{Binding SelectedModeUnavailableNote, Converter={StaticResource NotNullToVisible}}">
                        <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding SelectedModeUnavailableNote}" />
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" MinWidth="160" Margin="0,0,12,0" IsDefault="True"
                        Content="保存" Command="{Binding SaveCommand}" />
                <Button x:Name="ResetButton" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"
                        Content="初期値に戻す" Command="{Binding ResetCommand}"
                        AutomationProperties.HelpText="画面の値を初期値にします。保存するまで記録されません" />
                <Button x:Name="CloseButton" Style="{StaticResource SecondaryButton}" Content="閉じる" Command="{Binding CloseCommand}"
                        AutomationProperties.HelpText="保存せずにホームへ戻ります" />
            </StackPanel>
            <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" Text="Enter で保存、Esc で保存せずに閉じます" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
