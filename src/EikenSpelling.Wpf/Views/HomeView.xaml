<UserControl x:Class="EikenSpelling.Wpf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="760" Margin="24,20,24,24">
            <TextBlock Style="{StaticResource Sub}" FontWeight="Bold" Text="学習状況" Margin="0,0,0,8" />
            <UniformGrid Columns="5" Margin="0,0,0,24">
                <Border Style="{StaticResource Card}" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Sub}" Text="未出題" />
                        <TextBlock Style="{StaticResource Body}" FontSize="24" FontWeight="Bold" Text="{Binding Unseen}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Sub}" Text="通常" />
                        <TextBlock Style="{StaticResource Body}" FontSize="24" FontWeight="Bold" Text="{Binding Normal}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0" BorderBrush="{StaticResource Mistake}" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Sub}" Text="苦手" Foreground="{StaticResource MistakeText}" FontWeight="Bold" />
                        <TextBlock Style="{StaticResource Body}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource MistakeText}" Text="{Binding Weak}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Sub}" Text="克服済み" />
                        <TextBlock Style="{StaticResource Body}" FontSize="24" FontWeight="Bold" Text="{Binding Mastered}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Sub}" Text="再確認待ち" />
                        <TextBlock Style="{StaticResource Body}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Accent}" Text="{Binding ReviewDue}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Style="{StaticResource Heading}" Text="今日の練習" HorizontalAlignment="Center" Margin="0,0,0,16" />

            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                    <Label Target="{Binding ElementName=CountBox}" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource TextSub}" Content="問題数(_N)" />
                    <ComboBox x:Name="CountBox" MinWidth="96" ItemsSource="{Binding QuestionCountOptions}" SelectedItem="{Binding SelectedQuestionCount}"
                              AutomationProperties.Name="問題数" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                    <Label Target="{Binding ElementName=ModeBox}" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource TextSub}" Content="出題(_M)" />
                    <ComboBox x:Name="ModeBox" MinWidth="220" ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}"
                              DisplayMemberPath="Label" AutomationProperties.Name="出題方法" />
                </StackPanel>
                <CheckBox Content="苦手のみ(_W)" IsChecked="{Binding WeakOnly}" Margin="0,0,0,8" Foreground="{StaticResource TextSub}" />
            </WrapPanel>

            <Border Style="{StaticResource InfoBand}" Margin="0,0,0,12" Visibility="{Binding InfoMessage, Converter={StaticResource NotNullToVisible}}">
                <TextBlock Style="{StaticResource Body}" Text="{Binding InfoMessage}" />
            </Border>
            <Border Style="{StaticResource WarnBand}" Margin="0,0,0,12" Visibility="{Binding WarningMessage, Converter={StaticResource NotNullToVisible}}">
                <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource DangerText}" Text="{Binding WarningMessage, StringFormat=⚠ {0}}" />
            </Border>

            <Button x:Name="StartButton" IsDefault="True" Style="{StaticResource PrimaryButton}" Width="340" MinHeight="64" FontSize="22"
                    Content="始める" Command="{Binding StartCommand}" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Sub}" Text="Enter で始める" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
