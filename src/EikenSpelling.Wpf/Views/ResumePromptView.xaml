<UserControl x:Class="EikenSpelling.Wpf.Views.ResumePromptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="560" Margin="24,48,24,24" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Heading}" Text="前回の練習が途中です" HorizontalAlignment="Center" Margin="0,0,0,20" />
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" Padding="24,14" Margin="0,0,0,24">
                <TextBlock Style="{StaticResource Body}">
                    <Run Text="開始 " Foreground="{StaticResource TextSub}" /><Run Text="{Binding StartedAtText, Mode=OneWay}" />
                    <Run Text="    回答済み " Foreground="{StaticResource TextSub}" /><Run Text="{Binding Answered, Mode=OneWay}" FontWeight="Bold" /><Run Text=" / " /><Run Text="{Binding Total, Mode=OneWay}" /><Run Text=" 問" />
                </TextBlock>
            </Border>

            <Border Style="{StaticResource InfoBand}" Margin="0,0,0,16" Visibility="{Binding CannotResumeReason, Converter={StaticResource NotNullToVisible}}">
                <TextBlock Style="{StaticResource Body}" Text="{Binding CannotResumeReason}" />
            </Border>
            <Border Style="{StaticResource WarnBand}" Margin="0,0,0,16" Visibility="{Binding Message, Converter={StaticResource NotNullToVisible}}">
                <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource DangerText}" Text="{Binding Message, StringFormat=⚠ {0}}" />
            </Border>

            <Button x:Name="ResumeButton" Style="{StaticResource PrimaryButton}" Width="340" MinHeight="60" FontSize="20" Margin="0,0,0,12"
                    Content="続きから" Command="{Binding ResumeCommand}"
                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVisible}}" />
            <Button x:Name="DiscardButton" Style="{StaticResource SecondaryButton}" Width="340" MinHeight="52"
                    Content="終了して新しく始める" Command="{Binding DiscardCommand}" />
            <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,10,0,0" Text="終了しても、回答済みの記録は残ります" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
