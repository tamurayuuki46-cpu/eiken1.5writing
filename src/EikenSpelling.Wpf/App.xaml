<Application x:Class="EikenSpelling.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EikenSpelling.Wpf"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Tokens.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisible" />
            <local:NotNullToVisibleConverter x:Key="NotNullToVisible" />
            <local:InverseBoolToVisibleConverter x:Key="FalseToVisible" />
            <local:EmptyToVisibleConverter x:Key="EmptyToVisible" />
            <local:WordFontSizeConverter x:Key="WordFontSize" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
