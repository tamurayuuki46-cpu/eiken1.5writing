<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- 既存のテストプロジェクトと同じパッケージ・同じ版(新しいパッケージは足さない) -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- 一時フォルダ・固定時刻の道具は Persistence のテストと共有する(同じものを2か所に書かない) -->
    <Compile Include="..\EikenSpelling.Persistence.Tests\TestSupport.cs" Link="Shared\TestSupport.cs" />
    <!-- 失敗を入れられるファイル操作・テスト用の単語データは Flow のテストと共有する -->
    <Compile Include="..\EikenSpelling.Flow.Tests\FlowTestSupport.cs" Link="Shared\FlowTestSupport.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EikenSpelling.Presentation\EikenSpelling.Presentation.csproj" />
  </ItemGroup>

  <!-- 同梱の単語データを検査するため、出力フォルダへコピーする -->
  <ItemGroup>
    <None Include="..\..\src\EikenSpelling.Wpf\Data\words.json" Link="Data\words.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
